{
  "name": "@jameszambon/ui",
  "version": "0.0.4",
  "description": "Private design system for jameszambon Next.js apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thejames/theJZ-UI.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css",
    "./styles.css": "./dist/styles.css"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "prepublishOnly": "pnpm build",
    "build": "tsup && pnpm copy:css && pnpm build:css",
    "copy:css": "node -e \"require('fs').copyFileSync('src/theme.css','dist/theme.css')\"",
    "build:css": "tailwindcss -i src/styles-input.css -o dist/styles.css --minify",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch",
    "preview": "pnpm --filter playground dev",
    "release": "node scripts/release.mjs"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tailwindcss": "^4.0.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  },
  "dependencies": {
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "tailwind-merge": "^3.5.0"
  }
}

{
  "name": "@jameszambon/ui",
  "version": "0.0.0",
  "private": true,
  "description": "Private design system for jameszambon Next.js apps.",
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/thejames/theJZ-UI.git"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./theme.css": "./dist/theme.css"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup && pnpm copy:css",
    "copy:css": "node -e \"require('fs').copyFileSync('src/theme.css','dist/theme.css')\"",
    "typecheck": "tsc --noEmit",
    "dev": "tsup --watch"
  },
  "peerDependencies": {
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "tailwindcss": "^4.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "tsup": "^8.3.0",
    "typescript": "^5.6.0"
  }
}
